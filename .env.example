# The existing OpenAI/Codex account that will receive the OTP.
LOGIN_EMAIL=you@example.com

# IMAP mailbox used to read the OTP. Use an app password, never your normal password.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=replace-with-an-app-password
IMAP_FOLDER=INBOX
MAILBOX_ADDRESS=you@example.com

# Optional. The provider-specific code is intentionally visible in the example.
OTP_PATTERN=\b(\d{6})\b
OTP_SENDER=
MAILBOX_WAIT_SECONDS=90
EMAIL_RESEND_SECONDS=30
OUTPUT_FILE=codex-auth.json

# Workspace selection: 0 means personal; 1+ selects a team by list order.
# When no team is returned, 1+ automatically falls back to the personal space.
WORKSPACE_INDEX=1
EXPECTED_ACCOUNT_ID=

# Optional proxy. Leave empty for a direct connection.
AUTH_PROXY_URL=

# Optional Python interpreter (for example .venv/Scripts/python.exe on Windows).
CURL_CFFI_PYTHON=
