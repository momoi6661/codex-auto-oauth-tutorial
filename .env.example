# The existing OpenAI/Codex account that will receive the OTP.
LOGIN_EMAIL=you@example.com

# IMAP mailbox used to read the OTP. Use an app password, never your normal password.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=replace-with-an-app-password
IMAP_FOLDER=INBOX

# Optional. The provider-specific code is intentionally visible in the example.
OTP_PATTERN=\\b(\\d{6})\\b
MAILBOX_WAIT_SECONDS=90
OUTPUT_FILE=codex-auth.json

# Optional proxy. Leave empty for a direct connection.
HTTPS_PROXY=
